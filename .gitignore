# Real release signing material must never be committed - only the fixed, non-secret
# ci-debug.keystore (tracked deliberately, see app/build.gradle.kts) is meant to live in
# the repo. Anything matching these names is assumed to be the real thing.
release.keystore
release-keystore.*
*.jks
!ci-debug.keystore
