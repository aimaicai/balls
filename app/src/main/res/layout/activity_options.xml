<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:padding="32dp">

    <!-- Wrapped in a ScrollView now that a second button (Tutorial) sits below the match
         setup controls - the fixed, unscrolled layout this used to be was already tight on
         smaller screens even before that addition. -->
    <ScrollView
        android:id="@+id/optionsScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/customizeButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/optionsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/menu_options"
                android:textColor="@color/player_color"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/botsCountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:textColor="@color/hud_text"
                android:textSize="18sp" />

            <SeekBar
                android:id="@+id/botsSeekBar"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="200"
                android:min="2" />

            <TextView
                android:id="@+id/botAggressivenessText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textColor="@color/hud_text"
                android:textSize="18sp" />

            <SeekBar
                android:id="@+id/botAggressivenessSeekBar"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="10"
                android:min="1" />

            <TextView
                android:id="@+id/powerUpCountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textColor="@color/hud_text"
                android:textSize="18sp" />

            <SeekBar
                android:id="@+id/powerUpSeekBar"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="30"
                android:min="1" />

            <TextView
                android:id="@+id/arenaSizeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textColor="@color/hud_text"
                android:textSize="18sp" />

            <SeekBar
                android:id="@+id/arenaSizeSeekBar"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="3"
                android:min="0" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/musicSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/menu_music_label"
                android:textColor="@color/hud_text" />

            <TextView
                android:id="@+id/musicTrackLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/menu_music_track_label"
                android:textColor="@color/hud_text"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/musicTrackSpinner"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp" />

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/customizeButton"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="240dp"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:text="@string/menu_customize"
        app:layout_constraintBottom_toTopOf="@id/tutorialButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/tutorialButton"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="240dp"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:text="@string/menu_tutorial"
        app:layout_constraintBottom_toTopOf="@id/backButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/backButton"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="240dp"
        android:layout_height="56dp"
        android:layout_marginBottom="24dp"
        android:text="@string/options_back"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
