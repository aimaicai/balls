<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:padding="32dp">

    <!-- Wrapped in a ScrollView now that several buttons sit below the sound settings - the
         fixed, unscrolled layout this used to be was already tight on smaller screens even
         before that addition. -->
    <ScrollView
        android:id="@+id/optionsScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/matchSettingsButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/optionsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/menu_options"
                android:textColor="@color/player_color"
                android:textSize="28sp"
                android:textStyle="bold" />

            <include
                android:id="@+id/soundSettingsPanel"
                layout="@layout/sound_settings_panel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="16dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Hidden unless developer mode is enabled (see DeveloperSettings) - the match setup
         controls it leads to (bot count, power-up frequency, arena size, etc.) are now tucked
         away in MatchSettingsActivity rather than cluttering this screen. -->
    <Button
        android:id="@+id/matchSettingsButton"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="240dp"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:text="@string/menu_match_settings"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/customizeButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/customizeButton"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="240dp"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:text="@string/menu_customize"
        app:layout_constraintBottom_toTopOf="@id/tutorialButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/tutorialButton"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="240dp"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:text="@string/menu_tutorial"
        app:layout_constraintBottom_toTopOf="@id/backButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/backButton"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="240dp"
        android:layout_height="56dp"
        android:layout_marginBottom="24dp"
        android:text="@string/options_back"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
