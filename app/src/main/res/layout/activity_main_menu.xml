<?xml version="1.0" encoding="utf-8"?>
<!-- Scrollable, with the column centered vertically when it fits: on a short or 16:9 screen
     (or with developer mode's extra buttons showing) the bottom buttons used to be cut off
     with no way to reach them. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <!-- The app name and the tagline as two deliberate lines, instead of the full
             "name: tagline" title wrapping wherever the screen width happened to break it. -->
        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/player_color"
            android:textSize="36sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/taglineText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/game_tagline"
            android:textColor="@color/player_color"
            android:textSize="22sp"
            android:gravity="center" />

        <!-- Refreshed on every onResume so it's current whether returning from a match or from
             Options - a small, low-key nudge to play seen right before the Play button rather
             than a separate destination of its own. -->
        <TextView
            android:id="@+id/dailyChallengeText"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:textColor="@color/accent"
            android:textSize="14sp" />

        <!-- The one primary action on this screen - everything else (settings, secondary
             destinations) is a smaller outlined button below it. -->
        <Button
            android:id="@+id/playButton"
            android:layout_width="240dp"
            android:layout_height="64dp"
            android:layout_marginTop="32dp"
            android:text="@string/menu_play"
            android:textSize="18sp" />

        <!-- The alternative mode to classic Play, so it sits directly below it rather than among
             the smaller outlined secondary buttons - see RaceSetupActivity/RaceActivity. Hidden
             unless developer mode is enabled (tap the title above DEVELOPER_MODE_TAP_COUNT times) -
             see MainMenuActivity.updateDeveloperModeVisibility. -->
        <Button
            android:id="@+id/grandPrixButton"
            android:layout_width="240dp"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="@string/menu_grand_prix"
            android:textSize="16sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/testFinaleButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="240dp"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="@string/menu_test_finale"
            android:visibility="gone" />

        <Button
            android:id="@+id/highScoresButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="240dp"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="@string/menu_high_scores" />

        <Button
            android:id="@+id/achievementsButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="240dp"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="@string/menu_achievements" />

        <Button
            android:id="@+id/recordsButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="240dp"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="@string/menu_records" />

        <Button
            android:id="@+id/optionsButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="240dp"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="@string/menu_options" />

    </LinearLayout>
</ScrollView>
