<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:padding="32dp">

    <!-- Only shown when arriving straight from a just-finished match (see
         HighScoresActivity.EXTRA_MATCH_WON) - hidden when opened from the main menu. -->
    <TextView
        android:id="@+id/matchResultBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:fontFamily="monospace"
        android:textColor="@color/accent"
        android:textSize="18sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Only shown alongside matchResultBanner - a small, secondary line so the arcade
         score/leaderboard stays the main focus of the screen. -->
    <TextView
        android:id="@+id/matchStatsText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="monospace"
        android:textColor="@color/hud_text"
        android:textSize="12sp"
        android:alpha="0.75"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/matchResultBanner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/highScoresTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="monospace"
        android:text="@string/high_scores_title"
        android:textColor="@color/accent"
        android:textSize="26sp"
        android:textStyle="bold"
        android:letterSpacing="0.15"
        app:layout_constraintTop_toBottomOf="@id/matchStatsText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Only shown when this match's score landed at rank #1 - see HighScoresActivity;
         animated in over the fireworks. -->
    <TextView
        android:id="@+id/newRecordBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="monospace"
        android:text="@string/high_scores_new_record"
        android:textColor="@color/celebration_gold"
        android:textSize="22sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/highScoresTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:id="@+id/scoresScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/newRecordBanner"
        app:layout_constraintBottom_toTopOf="@id/buttonRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/scoresContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical" />

    </ScrollView>

    <LinearLayout
        android:id="@+id/buttonRow"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Hidden unless arriving from a just-finished match; see HighScoresActivity. -->
        <Button
            android:id="@+id/playAgainButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:text="@string/high_scores_play_again"
            android:textColor="@color/accent"
            android:textStyle="bold"
            android:visibility="gone" />

        <Button
            android:id="@+id/backButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:text="@string/high_scores_back"
            android:textColor="@color/accent"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Drawn last so it overlays everything else; only started for a brand-new #1 score
         (see HighScoresActivity), and stops itself a few seconds later. -->
    <com.hyperionsoftware.balls.ui.FireworksView
        android:id="@+id/fireworksView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
